{
  "metadata": {
    "id": "TD-PERF-GOR-01",
    "standard": "ISO/IEC/IEEE 29119-2:2021 (§3.11 & §8.3) & ISO/IEC 25010:2023",
    "base_url": "https://gorpermatabadminton.com",
    "safety_policy": "GET-only workload; max 10 VUs; think_time=500ms; auto-abort jika error_rate > 5%."
  },
  "routes": [
    "/",
    "/booking",
    "/login",
    "/fasilitas/lapangan"
  ],
  "browser_viewports": {
    "desktop": { "width": 1280, "height": 800 },
    "mobile": { "width": 390, "height": 844 }
  },
  "workload_tiers": [
    {
      "id": "LEVEL-A-BASELINE",
      "name": "Baseline Sequential (1 VU)",
      "vus": 1,
      "iterations_per_vu": 6,
      "think_time_ms": 250,
      "cooldown_after_s": 2.0
    },
    {
      "id": "LEVEL-B-NORMAL",
      "name": "Normal UMKM Concurrency (5 VUs)",
      "vus": 5,
      "iterations_per_vu": 2,
      "think_time_ms": 500,
      "cooldown_after_s": 2.0
    },
    {
      "id": "LEVEL-C-PEAK-SAFE",
      "name": "Peak-Safe UMKM Concurrency (10 VUs)",
      "vus": 10,
      "iterations_per_vu": 1,
      "think_time_ms": 500,
      "cooldown_after_s": 0.0
    }
  ],
  "circuit_breaker": {
    "max_error_rate_pct": 5.0,
    "abort_on_http_429": true,
    "request_timeout_s": 15.0
  },
  "sla_thresholds_ms": {
    "ttfb_default_max": 800,
    "ttfb_booking_max": 1800,
    "fcp_max": 3000,
    "lcp_max": 4000,
    "cls_max": 0.25,
    "p95_default_max": 1500,
    "p95_booking_max": 3000,
    "interaction_max": 250,
    "booking_html_uncompressed_warn_kb": 500
  }
}
